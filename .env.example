# Copy to .env and adjust — for running the BACKEND DIRECTLY ON THE HOST (`just test`,
# `just migrate`, `uv run python -m app.seed`). Pydantic reads it via `env_file=".env"`.
#
# The dev compose stack does NOT read this file: docker-compose.yml pins its own values as
# literals so a stray .env cannot change how the containers behave. Production does not read
# it either — that is env.production (see env.production.example and docs/remote-access.md).
#
# Keep Cloudflare/Access/tunnel settings OUT of this file. Two half-filled configs on one
# host is how the app ends up running with the wrong half.

TZ=America/Los_Angeles
ENVIRONMENT=dev
PUBLIC_BASE_URL=http://localhost:8088

# Host-side, so localhost rather than the compose service name.
DATABASE_URL=postgresql+asyncpg://chore:chore@localhost:5432/chore

# Media / storage
MEDIA_ROOT=/tmp/chorekeeper-media
MEDIA_RETENTION_DAYS=180
GEO_RETENTION_DAYS=30

# Local vision LLM (spec §7.2). Empty model = scoring off, everything fails open to
# NEEDS_REVIEW, which is what you want unless you are actually working on verification.
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=
LLM_VISION_API_KEY=not-needed
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1

# Verification banding
AUTO_PASS_THRESHOLD=0.85
AUTO_FAIL_THRESHOLD=0.35

# Web Push (spec §11) — generate a VAPID keypair; empty pair = push off
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Auth / sessions. DEV_AUTH is the passwordless picker the dev stack signs in with; the app
# refuses to start with it under ENVIRONMENT=prod or alongside CF_ACCESS_* (spec §12.1).
DEV_AUTH=true
SESSION_SECRET=dev-insecure-change-me
ADMIN_SESSION_HOURS=12
CHILD_SESSION_DAYS=90
COOKIE_SECURE=false
