# Copy to .env and adjust. Every value the app reads (spec §13.2).

TZ=America/Los_Angeles
# LAN dev: http://localhost:8088 — tunnel: https://chores.example.com
PUBLIC_BASE_URL=http://localhost:8088
ENVIRONMENT=dev

# Database
DATABASE_URL=postgresql+asyncpg://chore:chore@db:5432/chore

# Media / storage
MEDIA_ROOT=/data/media
MEDIA_RETENTION_DAYS=180
GEO_RETENTION_DAYS=30

# Local vision LLM (Phase 4)
LLM_VISION_BASE_URL=http://llm-vision:8081/v1
LLM_VISION_MODEL=
LLM_VISION_API_KEY=not-needed
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1

# Verification banding
AUTO_PASS_THRESHOLD=0.85
AUTO_FAIL_THRESHOLD=0.35

# Web Push (Phase 5) — generate a VAPID keypair
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Auth / sessions — sign-in is Google via Cloudflare Access (spec §12.1).
# The Google address of the parent-admin. Read once by the auth migration to give the
# existing admin an identity; changing it later is done in the app, not here.
ADMIN_EMAIL=
SESSION_SECRET=dev-insecure-change-me
ADMIN_SESSION_HOURS=12
CHILD_SESSION_DAYS=90
COOKIE_SECURE=false

# Remote access — Cloudflare Tunnel (spec §12.2; see docs/remote-access.md).
# Only used by docker-compose.tunnel.yml; leave blank for LAN dev.
CLOUDFLARE_TUNNEL_TOKEN=
ALLOWED_HOSTS=                       # e.g. chores.example.com (empty = no Host check)
TRUST_PROXY_HEADERS=false           # true only when actually behind the tunnel
# When both are set, ALL of /api/v1 requires a valid Cf-Access-Jwt-Assertion and its
# Google `email` claim becomes the login identity. Leave blank for LAN dev.
CF_ACCESS_TEAM_DOMAIN=              # e.g. yourteam.cloudflareaccess.com
CF_ACCESS_AUD=                      # comma-separated AUD tags, one per Access application
