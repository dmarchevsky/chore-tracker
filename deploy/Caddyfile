# Phase 1 placeholder. Phase 6 adds the full security-header set, HSTS, CSP,
# cache rules for /api/* and media, and the real hostname + TLS.

:80 {
	encode gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:8000
		header Cache-Control "private, no-store"
	}

	handle {
		reverse_proxy api:8000
	}
}
