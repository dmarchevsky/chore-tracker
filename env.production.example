# ChoreKeeper production environment — TEMPLATE (placeholders only, never put real
# secrets in git). Copy to env.production, fill it in, and keep it out of the repo
# (.gitignore covers env.production). With DockHand, paste the filled values as the
# stack's environment instead of hosting a file.
#
# Do NOT add ENVIRONMENT, COOKIE_SECURE or TRUST_PROXY_HEADERS here — docker-compose.prod.yml
# pins them to prod values and a copy here would only cause confusion.
# Generate a secret:  openssl rand -hex 32

# --- Required: secrets -----------------------------------------------------------
# Postgres superuser password for the stack. Use hex/base64 (URL-safe) output —
# DATABASE_URL is built from this one value, so avoid '#', '%' and '@'.
DB_PASSWORD=
SESSION_SECRET=
# Zero Trust → Networks → Tunnels → your tunnel → token (rotate if it ever leaks).
CLOUDFLARE_TUNNEL_TOKEN=
# Break-glass admin password, minimum 12 characters. Read by the first-run bootstrap on a
# brand-new database (docs/deploy-dockhand.md step 4); the running app never reads it, and it
# is changed afterwards under Settings -> Sign-in.
ADMIN_PASSWORD=

# --- Required: public identity -----------------------------------------------------
PUBLIC_BASE_URL=https://chores.example.com
ALLOWED_HOSTS=chores.example.com
# Google address of the parent-admin — the identity Cloudflare Access will present, and the
# one the app matches to let you in. On a brand-new database the first-run bootstrap creates
# the admin carrying it; re-running `python -m app.bootstrap` re-points them if it was wrong.
# It must also be on the Access policy (docs/remote-access.md §5h) — the app is only ever the
# second half of that pair. Afterwards it is changed under Settings -> Sign-in, not here.
ADMIN_EMAIL=you@example.com

# --- Cloudflare Access = Google sign-in (docs/remote-access.md §5) -----------------
# AUD tags of every Access application whose traffic reaches the API (the whole-app one
# and the admin-api one at minimum). CF_ACCESS_ISSUER only if the Zero Trust team was
# ever renamed — the cf_access.rejected log line prints the real iss value.
CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
CF_ACCESS_AUD=
CF_ACCESS_ISSUER=

# --- Optional: network ------------------------------------------------------------
LAN_DOOR_PORT=5173        # host port of the LAN break-glass door (home network only)
DB_USER=chore
DB_NAME=chore
DB_PORT=5432              # host loopback port for operator psql

# --- Optional: localization / retention ---------------------------------------------
HOUSEHOLD_NAME=Home       # shown in the app and in backup filenames
TZ=America/Los_Angeles
MEDIA_RETENTION_DAYS=180
GEO_RETENTION_DAYS=30

# --- Optional: vision LLM on another LAN machine -------------------------------------
# Empty base URL or model = photo scoring off; every photo routes to NEEDS_REVIEW
# (fail-open, spec §6.3). Prefer a LAN DNS name over a raw IP so a DHCP lease move
# does not silently disable scoring.
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=
LLM_VISION_API_KEY=not-needed
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=1

# --- Optional: verification banding / settlement --------------------------------------
AUTO_PASS_THRESHOLD=0.85
AUTO_FAIL_THRESHOLD=0.35
MISS_SETTLE_DELAY_S=21600
APPEAL_WINDOW_S=259200

# --- Optional: sessions -----------------------------------------------------------
ADMIN_SESSION_HOURS=12
CHILD_SESSION_DAYS=90

# --- Optional: web push (generate a VAPID keypair to enable; empty = push off) ------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services see (the VAPID `sub` claim). Empty is fine — a
# mailto is derived from PUBLIC_BASE_URL's hostname.
VAPID_SUBJECT=
